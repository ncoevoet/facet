{
  "name": "client",
  "version": "1.22.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "gen:i18n": "node scripts/gen-i18n-keys.mjs",
    "gen:api": "node scripts/gen-api-types.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "@mcp-b/webmcp-polyfill": "6.0.3",
    "@types/leaflet": "1.9.22",
    "chart.js": "4.5.1",
    "chartjs-adapter-date-fns": "3.0.0",
    "date-fns": "4.4.0",
    "leaflet": "1.9.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "angular-eslint": "22.6.0",
    "eslint": "9.39.5",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "zone.js": "0.16.3"
  },
  "overrides": {
    "ws": "8.20.1",
    "undici": "7.29.1",
    "piscina": "5.3.2",
    "vite": "8.3.5",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
