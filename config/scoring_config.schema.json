{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Facet scoring_config.json",
  "description": "Structural validation for the v4.0 category-centric scoring config. Top level stays open (additionalProperties true) so new sections don't break old validators; known sections are type-checked and each category is validated strictly to catch typos and wrong types.",
  "type": "object",
  "required": ["categories"],
  "properties": {
    "scanning": {
      "type": "object",
      "properties": {
        "skip_hidden_directories": { "type": "boolean" },
        "skip_directories": { "type": "array", "items": { "type": "string" } }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "priority"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "priority": { "type": "number" },
          "filters": { "type": "object" },
          "modifiers": { "type": "object" },
          "tags": { "type": "object" },
          "weights": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          }
        }
      }
    },
    "scoring_contexts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["label_key", "promote", "excluded", "suggest_from_moments"],
        "additionalProperties": false,
        "properties": {
          "label_key": { "type": "string", "minLength": 1 },
          "promote": { "type": "array", "items": { "type": "string" } },
          "excluded": { "type": "array", "items": { "type": "string" } },
          "suggest_from_moments": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "auto_retrain": {
      "type": "object",
      "description": "Personal learning dispatch policy; external retains genuine comparisons and pending counts without local learned inference.",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "native",
            "external"
          ],
          "default": "native"
        }
      },
      "additionalProperties": true
    },
    "viewer": {
      "type": "object",
      "properties": {
        "place_search_url": {
          "type": "string",
          "description": "Photon forward-search endpoint; empty disables online lookup. Server-only; no credentials or query parameters."
        },
        "trusted_local_editing": {
          "type": "boolean",
          "default": false,
          "description": "Grant edition rights to a direct loopback same-origin browser on a single-user viewer with no browse password and no edition password; every edition route except the scan trigger. Forwarded requests are refused; never enable behind a reverse proxy on the same host."
        },
        "cull": {
          "type": "object",
          "properties": {
            "allow_trash": { "type": "boolean" }
          }
        },
        "mcp": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "bridge": { "type": "boolean" },
            "max_rows": { "type": "integer", "minimum": 1, "maximum": 500 },
            "max_bytes": { "type": "integer", "minimum": 4000, "maximum": 500000 },
            "max_image_bytes": { "type": "integer", "minimum": 32768, "maximum": 2097152 },
            "call_timeout_s": { "type": "number", "minimum": 1, "maximum": 300 },
            "semantic_timeout_s": { "type": "number", "minimum": 1, "maximum": 300 },
            "rate_per_min": { "type": "integer", "minimum": 1 },
            "write_rate_per_min": { "type": "integer", "minimum": 1 },
            "tool_profile": { "enum": ["full", "core"] },
            "allow_destructive": { "type": "boolean" },
            "inpage_tools": { "type": "boolean" },
            "allowed_origins": { "type": "array", "items": { "type": "string", "format": "uri" } }
          }
        }
      }
    },
    "hdr_pq_tonemap": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "method": { "enum": ["hable", "clip"] },
        "white_point": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["percentile", "max", "fixed"] },
            "percentile": { "type": "number", "minimum": 0, "maximum": 100 },
            "min_nits": { "type": "number", "minimum": 0 },
            "max_nits": { "type": "number", "minimum": 0 },
            "fixed_nits": { "type": "number", "minimum": 0 }
          }
        },
        "chroma_preserve": { "enum": ["per_channel", "max_channel"] }
      }
    },
    "processing": { "type": "object" },
    "scoring": { "type": "object" },
    "thresholds": { "type": "object" },
    "normalization": { "type": "object" },
    "burst_detection": { "type": "object" },
    "duplicate_detection": { "type": "object" },
    "face_detection": { "type": "object" },
    "face_clustering": {
      "type": "object",
      "properties": {
        "thresholds_by_model": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "auto_merge_distance_percent": { "type": "number", "minimum": 0, "maximum": 100 },
              "merge_threshold": { "type": "number", "minimum": -1, "maximum": 1 }
            }
          }
        }
      }
    },
    "capsules": { "type": "object" },
    "performance": { "type": "object" },
    "maintenance": { "type": "object" },
    "critique": { "type": "object" },
    "auto_cull": { "type": "object" },
    "distortion_attributes": { "type": "object" },
    "skin_tone": { "type": "object" },
    "iqa_extended": {
      "type": "object",
      "properties": {
        "qrealign": { "enum": [true, false, "auto"] },
        "qrealign_size": { "enum": ["mini", "lite"] },
        "aesthetic_v25": { "type": "boolean" },
        "deqa": { "type": "boolean" }
      }
    },
    "licensing": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["default", "commercial"] },
        "allow_unclear": { "type": "boolean" }
      }
    },
    "ocr": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "languages": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "full_resolution": { "type": "boolean" }
      }
    },
    "immich": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "api_key": { "type": "string" },
        "timeout_seconds": { "type": "number" },
        "path_map": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "facet_prefix": { "type": "string" },
              "immich_prefix": { "type": "string" }
            }
          }
        },
        "push": {
          "type": "object",
          "properties": {
            "ratings": { "type": "boolean" },
            "favorites": { "type": "boolean" },
            "rejected": { "type": "boolean" },
            "top_picks_album": { "type": "string" },
            "top_picks_min_rating": { "type": "number" }
          }
        },
        "webhook": {
          "type": "object",
          "properties": {
            "token_env": { "type": "string" },
            "header": { "type": "string" },
            "max_pending": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "vlm_backend": {
      "type": "object",
      "properties": {
        "type": { "enum": ["local", "ollama", "openai_compatible"] }
      }
    },
    "xmp_export": { "type": "object" }
  }
}
