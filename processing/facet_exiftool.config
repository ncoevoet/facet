# Facet organization metadata; load with -config as the first ExifTool argument.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        facet => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::facet' } },
    },
);
%Image::ExifTool::UserDefined::facet = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-facet', 2 => 'Image' },
    NAMESPACE => { facet => 'https://github.com/ncoevoet/facet/ns/1.0/' },
    WRITABLE => 'string',
    ReviewDecision => {},
    GPSState => {},
);
1;
