# Facet deployment knobs. Copy to `.env` and edit — docker compose reads it automatically.
# These are the only things most deployments need to change; the rest — weights,
# viewer password, categories — lives in ./facet-config/scoring_config.json, a
# persistent host file docker-entrypoint.sh seeds from the image's default on
# first run, and every runtime config write (and any hand edit) survives
# `down && up`. Edit it directly; there is nothing to uncomment here for it.
# docker-compose.yml points there via FACET_CONFIG (config/scoring_config.py and
# api/config.py both honor that variable directly, for non-Docker uses too).

# VRAM profile: auto | legacy | 8gb | 16gb | 24gb
#   auto  -> detects from the GPU (16 GB card => 16gb; no GPU => legacy)
#   Overrides models.vram_profile in the config (honored by config/scoring_config.py).
FACET_VRAM_PROFILE=auto

# Host directory of photos to analyze (bind-mounted read-write into the container —
# writable so sidecar/XMP export can write next to the originals).
PHOTOS_DIR=./photos

# Host port to expose the web viewer on (container always listens on 5000).
PORT=5000

# Database path inside the container (kept on the ./data bind mount).
DB_PATH=/app/data/photo_scores_pro.db

# Personal-ranker auto-retrain, for heavy raters. Leave unset to use the config's
# `auto_retrain` block (25 new comparisons, 60s idle). Raise the threshold to train
# on bigger batches; raise the idle window if you rate in long uninterrupted runs.
#FACET_RETRAIN_THRESHOLD=25
#FACET_RETRAIN_IDLE_S=60
